# Copy to api/.env for local (non-Docker) runs. Never commit .env.

PORT=4000
NODE_ENV=development

# Matches root docker-compose.yml defaults when Postgres is on the host
DATABASE_URL=postgresql://linkrowth:linkrowth@localhost:5432/linkrowth

# Shared secret for extension → API (Authorization: Bearer <API_KEY>)
# Generate with: openssl rand -hex 32
API_KEY=dev-change-me

# Agent LLM settings (in-process engage — same vars as agent/.env.example)
LINKROWTH_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
LINKROWTH_OPENAI_MODEL=gpt-4o-mini
LINKROWTH_GEMINI_MODEL=gemini-2.5-flash
# Stronger model for the analyzer (defaults in code: gpt-5.4 / gemini-2.5-pro)
LINKROWTH_OPENAI_ANALYZE_MODEL=gpt-5.4
LINKROWTH_GEMINI_ANALYZE_MODEL=gemini-2.5-pro
# Optional stronger model for the drafter only (falls back to the default above)
# LINKROWTH_OPENAI_DRAFT_MODEL=gpt-5.4
# LINKROWTH_GEMINI_DRAFT_MODEL=gemini-2.5-pro

# Experience-index retrieval (optional — missing index degrades to static user.json)
# LINKROWTH_OPENAI_EMBED_MODEL=text-embedding-3-small
# LINKROWTH_GEMINI_EMBED_MODEL=gemini-embedding-001
# LINKROWTH_EXPERIENCE_INDEX_DB=
# LINKROWTH_RETRIEVAL_K=5
# LINKROWTH_RETRIEVAL_MIN_SCORE=0.3
