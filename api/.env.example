# Copy to api/.env for local (non-Docker) runs. Never commit .env.

PORT=4000
NODE_ENV=development

# Matches root docker-compose.yml defaults when Postgres is on the host
DATABASE_URL=postgresql://linkrowth:linkrowth@localhost:5432/linkrowth

# Shared secret for extension → API (Authorization: Bearer <API_KEY>)
# Generate with: openssl rand -hex 32
API_KEY=dev-change-me
