# Copy to .env and fill in. Never commit .env.

# GitHub extract (fine-grained PAT)
GITHUB_TOKEN=

# Distill + embed. Same provider switch as agent/.
LINKROWTH_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional chat-model overrides (distill pass)
# LINKROWTH_OPENAI_MODEL=gpt-4o-mini
# LINKROWTH_GEMINI_MODEL=gemini-2.5-flash

# Optional embedding-model overrides (index pass)
# LINKROWTH_OPENAI_EMBED_MODEL=text-embedding-3-small
# LINKROWTH_GEMINI_EMBED_MODEL=gemini-embedding-001

# Optional batch controls
# DISTILL_CONCURRENCY=3
# DISTILL_LIMIT=
# DISTILL_FORCE=0
# SEARCH_K=5
