{
  "name": "@linkrowth/agent",
  "version": "0.1.0",
  "private": true,
  "description": "Linkrowth agent — CLI engage (comment suggestion) and related tooling",
  "license": "MIT",
  "bin": {
    "linkrowth": "./dist/cli.js"
  },
  "exports": {
    "./engage": {
      "types": "./dist/core/engage.d.ts",
      "default": "./dist/core/engage.js"
    },
    "./runs": {
      "types": "./dist/persistence/runEngage.d.ts",
      "default": "./dist/persistence/runEngage.js"
    },
    "./llm": {
      "types": "./dist/llm/index.d.ts",
      "default": "./dist/llm/index.js"
    },
    "./types": {
      "types": "./dist/core/types.d.ts",
      "default": "./dist/core/types.js"
    }
  },
  "scripts": {
    "prebuild": "npm run build --prefix ../db",
    "build": "tsc -p tsconfig.json",
    "engage": "node dist/cli.js engage",
    "dev": "tsx src/cli.ts engage",
    "eval": "tsx evals/runEvaluation.ts",
    "eval:retrieval": "tsx src/context/retrievalEvalCli.ts",
    "test": "tsx --test src/agents/*.test.ts src/context/experience/*.test.ts src/context/*.test.ts src/persistence/retrievalTrace/*.test.ts"
  },
  "dependencies": {
    "@linkrowth/db": "file:../db",
    "@google/genai": "^1.10.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.0",
    "openai": "^5.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18"
  }
}
