# Copy to agent/.env and fill in values. Never commit .env.

# Postgres (required for engage) — matches root docker-compose.yml defaults
DATABASE_URL=postgresql://linkrowth:linkrowth@localhost:5432/linkrowth

# Active LLM provider: openai | gemini
LINKROWTH_PROVIDER=openai

# Engage pipeline: multi_step_engage (default) | one_shot_engage
# LINKROWTH_AGENT=multi_step_engage

# Provider API keys — only the active provider's key is required
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional default model overrides per provider
LINKROWTH_OPENAI_MODEL=gpt-4o-mini
LINKROWTH_GEMINI_MODEL=gemini-2.5-flash

# OpenLIT / OpenTelemetry visibility (optional)
# Enable with LINKROWTH_OPENLIT=1, or by setting OTEL_EXPORTER_OTLP_ENDPOINT.
# Without an endpoint, OpenLIT prints traces to the console (SDK only — no UI process).
# LINKROWTH_OPENLIT=1
#
# OTLP destination (omit for console). Do NOT use 127.0.0.1 from the API Docker
# container — that is the container itself. Prefer a compose service name, or
# host.docker.internal when the collector runs on the Mac host.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SERVICE_NAME=linkrowth-agent
# OTEL_DEPLOYMENT_ENVIRONMENT=development
# LINKROWTH_OPENLIT_CAPTURE_CONTENT=true
# LINKROWTH_OPENLIT_DISABLE_BATCH=true
