# Copy to extension/.env and fill in values. Never commit .env.
# Phase 1 triage is local-only; these matter from Phase 2 (API bridge) onward.

# Linkrowth API base URL (agent/API service)
# LINKROWTH_API_URL=http://localhost:4000

# Same value as api/.env API_KEY — sent as Authorization: Bearer <key>
# LINKROWTH_API_KEY=dev-change-me
